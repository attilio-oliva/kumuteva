# Generated files
/target/

venv

# Raw experiment data — too large for git (~8 GB).
# Published as a release asset instead; see new_fairness_results/README.md.
new_fairness_results/raw/
new_fairness_results/raw_*/
new_fairness_results/kumuteva_raw_results/
new_fairness_results/kumuteva_raw_results.zip
**/__pycache__/

# Output of validate_analysis.py — regenerated on demand.
new_fairness_results/_validation_figures/

# Measurement output written into the repository.
#
# `fairness --output-dir` still defaults to a repo-relative `fairness_results`
# (main.rs OUTPUT_DIR), so a hand-run assessment drops results into the source
# tree. The campaign scripts already write to $HOME/kumuteva-runs and
# $HOME/kumuteva-mtb; this keeps the manual path from re-committing 300 MB of
# CSVs and PNGs, as happened before.
/fairness_results/
/kumuteva-runs/
/kumuteva-mtb/

# Figures and tables regenerated from the run data by the analysis scripts.
# The generators are the source; these are their output.
new_fairness_results/*.pgf
new_fairness_results/*.png
new_fairness_results/*.tex
new_fairness_results/*.ipynb
new_fairness_results/*.html
new_fairness_results/mtb/
new_fairness_results/mtb_catalogue.json
new_fairness_results/mtb_evidence_facts.md
new_fairness_results/mtb_feature_table.md
